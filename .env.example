# ─────────────────────────────────────────────────────────────────────────────
# iiskills-in — environment variable template
#
# Copy this file to .env.local (development) or .env.production.local (prod)
# and fill in the real secret values.
#
# NEVER commit files containing real keys.  Only this .env.example is safe
# to commit because all values here are either public or placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase project (Project ID: octgncmruhsbrxpxrkzl) ────────────────────

# Public URL for the Supabase project — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://octgncmruhsbrxpxrkzl.supabase.co

# Anon/public key — safe to expose to the browser (row-level security applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service-role key — SERVER SIDE ONLY, never expose to the browser
# Used by scripts/sync-lessons.ts to bypass RLS during database seeding
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Site / Auth ─────────────────────────────────────────────────────────────

# Canonical public URL of this deployment
NEXT_PUBLIC_SITE_URL=https://iiskills.in

# Supabase Auth redirect URI — must be added to the Supabase dashboard under
# Authentication > URL Configuration > Redirect URLs
SUPABASE_AUTH_REDIRECT_URL=https://iiskills.in/auth/callback

# ── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=production
