# ─────────────────────────────────────────────────────────────────────────────
# apps/main — Production environment (non-secret public values only)
# SECRET values (SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY)
# go in .env.production.local which is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Site URL — used by middleware, redirects, and OG tags
NEXT_PUBLIC_SITE_URL=https://iiskills.in

# Supabase project URL (public — not a secret)
NEXT_PUBLIC_SUPABASE_URL=https://octgncmruhsbrxpxrkzl.supabase.co

# Supabase Auth — redirect URI after OAuth / magic-link sign-in
SUPABASE_AUTH_REDIRECT_URL=https://iiskills.in/auth/callback

# Node environment
NODE_ENV=production
